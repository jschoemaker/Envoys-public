# Copy this to .env and fill in your values

# Google OAuth — get these from console.cloud.google.com
# APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Add http://localhost:3000/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public URL of your server (used to build the OAuth callback URL)
# Change this when deploying
BASE_URL=http://localhost:3000

# Email — recovery links (any SMTP server)
# If unset, recovery links log to the console instead (fine for dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Envoys <noreply@yourdomain.com>

# Admin — manual tier upgrades until Stripe is wired in
# Set a strong random value. Endpoint is disabled if unset.
ADMIN_KEY=

# Optional overrides
PORT=3000
SERVICE_DOMAIN=envoys.me
# DB_PATH=./envoys.db
