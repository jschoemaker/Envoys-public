# Copy this to .env and fill in your values

# The public URL of your server (used to build keyid / did:web document URLs)
# Change this when deploying
BASE_URL=http://localhost:3000

# Admin — manual tier upgrades until Stripe is wired in
# Set a strong random value. Endpoint is disabled if unset.
ADMIN_KEY=

# Optional overrides
PORT=3000
SERVICE_DOMAIN=envoys.me
# DB_PATH=./envoys.db

# did:web:envoys.me service identity — public key (JWK x value, base64url, 43 chars).
# Generate locally with: node ../../envoys-public/scripts/gen-service-did-key.mjs
# The matching private key stays on the dev machine; the server only needs the public JWK x.
# If unset, GET /.well-known/did.json returns 503.
ENVOYS_SERVICE_DID_PUBLIC_JWK_X=
